# Tile caches. Large, machine-specific, and rebuilt on demand from the
# providers. The default lives in ~/.cache/gpx-tools, but a checkout that
# points GPX_TOOLS_CACHE at itself should not commit the result.
.demcache/
tiles/

# Secrets. The tile providers' API keys are read from here.
.env

# Output
*.jpg
*.png
*.svg
route.json
photos.json
voxel.json
totals.json
merged.gpx

__pycache__/
*.pyc

# Build artefacts
build/
dist/
*.egg-info/

# Development
.venv/
.pytest_cache/
.coverage
.ruff_cache/
